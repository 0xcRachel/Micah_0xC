{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Micah_0xC",
  "version": "1.0.0",
  "identifier": "com.micah0xc.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Micah 0xC",
        "width": 1380,
        "height": 760,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/dlls/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "micah0xc"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5Rjc0MkQ2RDBENjM5QzIKUldUQ09kYlExa0wzdVR3dFlMdDZZMFhUR2JlT1U5REVkMERkK3Y0N3pyNTBXN0Z3Tng0Z05UL2YK",
      "endpoints": [
        "https://github.com/0xcRachel/Micah_0xC/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
